{
  "name": "buzzquiz",
  "version": "1.0.0",
  "description": "AI personality quiz generator with reusable layouts and themes",
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "format": "prettier --write src convex scripts tests *.ts *.json README.md docs",
    "format:check": "prettier --check src convex scripts tests *.ts *.json README.md docs",
    "migrate:local": "node --env-file=.env.local --import tsx scripts/migrate-local.ts",
    "topics:backfill": "node --env-file=.env.local --import tsx scripts/backfill-topics.ts",
    "library:index": "node --env-file=.env.local --import tsx scripts/index-library.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "convex": "^1.50.0",
    "lucide-react": "^1.72.0",
    "next": "^16.4.6",
    "openai": "^7.57.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "^0.35.5",
    "unicode-emoji-json": "0.9.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "convex-test": "^0.0.71",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "private": true,
  "engines": {
    "node": "24.x"
  }
}
