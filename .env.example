# Run `npx convex dev` to configure your own Convex project.
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=
# Production uses a server-only URL, set by `convex deploy` on Vercel.
CONVEX_URL=
# Generate a random secret and set the SAME value in Convex and the Next.js server.
BUZZQUIZ_SERVER_SECRET=
# Set this in Convex. Counts new outcome sets, question sets, and personal readings.
DAILY_GENERATION_LIMIT=5
# OpenRouter takes priority if both provider keys are configured.
OPENROUTER_API_KEY=
QUIZ_AI_MODEL=openai/gpt-6-sol
QUIZ_IMAGE_MODEL=google/gemini-3.1-flash-image
QUIZ_FOREGROUND_MODEL=openai/gpt-image-2.6-flare
# Optional direct OpenAI alternative.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
OPENAI_IMAGE_MODEL=gpt-image-2
# Set CONVEX_DEPLOY_KEY only in Vercel Production for automatic backend deployments.
